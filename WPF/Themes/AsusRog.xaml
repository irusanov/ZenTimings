<!--
    AsusRog theme. The palette below is all a theme has to define: the control brushes are built from it
    (Theming/ColorSchemes) and the application colors default to it (Themes/ThemeCommon.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:ZenTimings.Theming;assembly=ZenTimings">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ZenTimings;component/Theming/ColorSchemes/Dark.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/ThemeCommon.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/SharedAssets.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Resources/vendor/asus/rog/rog-logo-alt.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Resources/vendor/gskill/gskill-logo-alt.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Palette -->
    <Color x:Key="{x:Static theming:ThemeColors.BackgroundColor}">#0F0D0E</Color> <!-- window -->
    <Color x:Key="{x:Static theming:ThemeColors.SurfaceColor}">#12A71C1E</Color> <!-- cards and group boxes (translucent, so it also works on gradients) -->
    <Color x:Key="{x:Static theming:ThemeColors.PopupColor}">#161112</Color> <!-- menus, drop-downs, tool tips -->
    <Color x:Key="{x:Static theming:ThemeColors.BorderColor}">#808A1E1E</Color> <!-- control, card and popup outlines -->
    <Color x:Key="{x:Static theming:ThemeColors.ForegroundColor}">#C2C2C2</Color>
    <Color x:Key="{x:Static theming:ThemeColors.SecondaryForegroundColor}">#B8C2C2C2</Color>
    <Color x:Key="{x:Static theming:ThemeColors.DisabledForegroundColor}">#66C2C2C2</Color>
    <Color x:Key="{x:Static theming:ThemeColors.AccentColor}">#B32022</Color> <!-- switches, selection, main buttons -->
    <Color x:Key="{x:Static theming:ThemeColors.AccentForegroundColor}">#F3F3F3</Color> <!-- text on the accent color -->
    <Color x:Key="{x:Static theming:ThemeColors.SuccessColor}">#4CC38A</Color>
    <Color x:Key="{x:Static theming:ThemeColors.WarningColor}">#FFC107</Color>
    <Color x:Key="{x:Static theming:ThemeColors.ErrorColor}">#FF6B6B</Color>

    <!-- Application colors that differ from the defaults in ThemeCommon.xaml -->
    <SolidColorBrush x:Key="AccentTextColor" Color="#A2C7C6" />
    <SolidColorBrush x:Key="BottomPanelBackground" Color="#220807" />
    <SolidColorBrush x:Key="MainMenuPanelBackground" Color="#4E0A08" />
    <SolidColorBrush x:Key="MenuItemBackground" Color="#4E0A08" />
    <SolidColorBrush x:Key="SeparatorColor" Color="#55A12A2A" />
    <SolidColorBrush x:Key="SuccessBackground" Color="#327B56" />
    <SolidColorBrush x:Key="DisabledColor" Color="#847676" />
    <SolidColorBrush x:Key="WindowBorderColor" Color="#8A1E1E" />

    <!-- Window background: vertical gradient, a soft red diagonal fade and an edge vignette -->
    <LinearGradientBrush x:Key="BackgroundGradientBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#220807" Offset="1.0" />
        <GradientStop Color="#0F0D0E" Offset="0.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BackgroundDiagonalFadeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#20A71C1E" Offset="0.0" />
        <GradientStop Color="#18A71C1E" Offset="0.28" />
        <GradientStop Color="#02000000" Offset="0.55" />
        <GradientStop Color="#00000000" Offset="1.0" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="BackgroundVignetteBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="#00000000" Offset="0.72" />
        <GradientStop Color="#44000000" Offset="1.0" />
    </RadialGradientBrush>

    <DrawingBrush x:Key="WindowBackgroundBrush" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BackgroundGradientBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1000,700" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource BackgroundDiagonalFadeBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1000,700" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource BackgroundVignetteBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1000,700" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Panels are transparent so the window gradient shows through -->
    <Style x:Key="MainMenuStyles" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{x:Null}" />
        <Setter Property="Padding" Value="5 2 7 2" />
    </Style>

    <Style x:Key="MenuStyles" TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{x:Null}" />
    </Style>

    <Style x:Key="BottomPanelStyles" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="5" />
        <Setter Property="Background" Value="{x:Null}" />
    </Style>

    <Style x:Key="PanelStyles" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{x:Null}" />
    </Style>

    <Style x:Key="WindowStyles" TargetType="{x:Type Window}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderColor}" />
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
    </Style>
</ResourceDictionary>
