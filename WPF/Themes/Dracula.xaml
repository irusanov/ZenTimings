<!--
    Dracula theme. The palette below is all a theme has to define: the control brushes are built from it
    (Theming/ColorSchemes) and the application colors default to it (Themes/ThemeCommon.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:ZenTimings.Theming;assembly=ZenTimings">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ZenTimings;component/Theming/ColorSchemes/Dark.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/ThemeCommon.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/SharedAssets.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Palette -->
    <Color x:Key="{x:Static theming:ThemeColors.BackgroundColor}">#282A36</Color> <!-- window -->
    <Color x:Key="{x:Static theming:ThemeColors.SurfaceColor}">#0DFFFFFF</Color> <!-- cards and group boxes (translucent, so it also works on gradients) -->
    <Color x:Key="{x:Static theming:ThemeColors.PopupColor}">#44475A</Color> <!-- menus, drop-downs, tool tips -->
    <Color x:Key="{x:Static theming:ThemeColors.BorderColor}">#1AFFFFFF</Color> <!-- control, card and popup outlines -->
    <Color x:Key="{x:Static theming:ThemeColors.ForegroundColor}">#BD93F9</Color>
    <Color x:Key="{x:Static theming:ThemeColors.SecondaryForegroundColor}">#B8BD93F9</Color>
    <Color x:Key="{x:Static theming:ThemeColors.DisabledForegroundColor}">#66BD93F9</Color>
    <Color x:Key="{x:Static theming:ThemeColors.AccentColor}">#FF79C6</Color> <!-- switches, selection, main buttons -->
    <Color x:Key="{x:Static theming:ThemeColors.AccentForegroundColor}">#282A36</Color> <!-- text on the accent color -->
    <Color x:Key="{x:Static theming:ThemeColors.SuccessColor}">#50FA7B</Color>
    <Color x:Key="{x:Static theming:ThemeColors.WarningColor}">#F1FA8C</Color>
    <Color x:Key="{x:Static theming:ThemeColors.ErrorColor}">#FF5555</Color>

    <CornerRadius x:Key="{x:Static theming:ThemeDimensions.CornerRadius}">2</CornerRadius>

    <!-- Application colors that differ from the defaults in ThemeCommon.xaml -->
    <SolidColorBrush x:Key="SeparatorColor" Color="#BD93F9" />
    <SolidColorBrush x:Key="SuccessBackground" Color="#50FA7B" />
    <SolidColorBrush x:Key="DisabledColor" Color="#44475A" />
    <SolidColorBrush x:Key="WindowBorderColor" Color="#BD93F9" />
    <SolidColorBrush x:Key="LogoColorAlt" Color="#D1D4C9" />
    <SolidColorBrush x:Key="LiveSnapshotBrush" Color="{StaticResource {x:Static theming:ThemeColors.AccentColor}}" />
</ResourceDictionary>
