<!--
    DarkMintGradient theme. The palette below is all a theme has to define: the control brushes are built from it
    (Theming/ColorSchemes) and the application colors default to it (Themes/ThemeCommon.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:ZenTimings.Theming;assembly=ZenTimings">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ZenTimings;component/Theming/ColorSchemes/Dark.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/ThemeCommon.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/SharedAssets.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Palette -->
    <Color x:Key="{x:Static theming:ThemeColors.BackgroundColor}">#092237</Color> <!-- window -->
    <Color x:Key="{x:Static theming:ThemeColors.SurfaceColor}">#10FFFFFF</Color> <!-- cards and group boxes (translucent, so it also works on gradients) -->
    <Color x:Key="{x:Static theming:ThemeColors.PopupColor}">#0C2D4A</Color> <!-- menus, drop-downs, tool tips -->
    <Color x:Key="{x:Static theming:ThemeColors.BorderColor}">#1AFFFFFF</Color> <!-- control, card and popup outlines -->
    <Color x:Key="{x:Static theming:ThemeColors.ForegroundColor}">#D1D4C9</Color>
    <Color x:Key="{x:Static theming:ThemeColors.SecondaryForegroundColor}">#B8D1D4C9</Color>
    <Color x:Key="{x:Static theming:ThemeColors.DisabledForegroundColor}">#66D1D4C9</Color>
    <Color x:Key="{x:Static theming:ThemeColors.AccentColor}">#7CCAA2</Color> <!-- switches, selection, main buttons -->
    <Color x:Key="{x:Static theming:ThemeColors.AccentForegroundColor}">#1F2029</Color> <!-- text on the accent color -->
    <Color x:Key="{x:Static theming:ThemeColors.SuccessColor}">#4CC38A</Color>
    <Color x:Key="{x:Static theming:ThemeColors.WarningColor}">#FFC107</Color>
    <Color x:Key="{x:Static theming:ThemeColors.ErrorColor}">#FF6B6B</Color>

    <CornerRadius x:Key="{x:Static theming:ThemeDimensions.CornerRadius}">2</CornerRadius>

    <!-- Application colors that differ from the defaults in ThemeCommon.xaml -->
    <SolidColorBrush x:Key="SuccessBackground" Color="#327B56" />
    <SolidColorBrush x:Key="DisabledColor" Color="#5B6C70" />
    <SolidColorBrush x:Key="SeparatorColor" Color="#14151A" />
    <SolidColorBrush x:Key="WindowBorderColor" Color="#14151A" />

    <!-- Sensors window sections -->
    <SolidColorBrush x:Key="SensorGroupHeaderBackground" Color="#1A2B45" />
    <SolidColorBrush x:Key="SensorGroupHeaderForeground" Color="#E6EAF0" />
    <SolidColorBrush x:Key="SensorGroupBackground" Color="#0E1F35" />
    <SolidColorBrush x:Key="SensorModuleInfoBackground" Color="#0A182A" />
    <SolidColorBrush x:Key="SensorModuleInfoBorder" Color="#2A3B55" />
    <SolidColorBrush x:Key="SensorColumnHeaderBackground" Color="#0F1D33" />
    <SolidColorBrush x:Key="SensorColumnHeaderForeground" Color="#A9B4C4" />
    <SolidColorBrush x:Key="SensorColumnHeaderBorder" Color="#22324A" />

    <!-- Window background: vertical gradient -->
    <LinearGradientBrush x:Key="BackgroundGradientBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#092237" Offset="0.0" />
        <GradientStop Color="#161B37" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Panels are transparent so the window gradient shows through -->
    <Style x:Key="MainMenuStyles" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{x:Null}" />
        <Setter Property="Padding" Value="5 2 7 2" />
    </Style>

    <Style x:Key="MenuStyles" TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{x:Null}" />
    </Style>

    <Style x:Key="BottomPanelStyles" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="5" />
        <Setter Property="Background" Value="{x:Null}" />
    </Style>

    <Style x:Key="PanelStyles" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{x:Null}" />
    </Style>

    <Style x:Key="WindowStyles" TargetType="{x:Type Window}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderColor}" />
        <Setter Property="Background" Value="{StaticResource BackgroundGradientBrush}" />
    </Style>
</ResourceDictionary>
