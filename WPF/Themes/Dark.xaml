<!--
    Dark theme. The palette below is all a theme has to define: the control brushes are built from it
    (Theming/ColorSchemes) and the application colors default to it (Themes/ThemeCommon.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:ZenTimings.Theming;assembly=ZenTimings">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ZenTimings;component/Theming/ColorSchemes/Dark.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/ThemeCommon.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/SharedAssets.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Palette -->
    <Color x:Key="{x:Static theming:ThemeColors.BackgroundColor}">#2A2B34</Color> <!-- window -->
    <Color x:Key="{x:Static theming:ThemeColors.SurfaceColor}">#0DFFFFFF</Color> <!-- cards and group boxes (translucent, so it also works on gradients) -->
    <Color x:Key="{x:Static theming:ThemeColors.PopupColor}">#363744</Color> <!-- menus, drop-downs, tool tips -->
    <Color x:Key="{x:Static theming:ThemeColors.BorderColor}">#1AFFFFFF</Color> <!-- control, card and popup outlines -->
    <Color x:Key="{x:Static theming:ThemeColors.ForegroundColor}">#D5D5D5</Color>
    <Color x:Key="{x:Static theming:ThemeColors.SecondaryForegroundColor}">#B8D5D5D5</Color>
    <Color x:Key="{x:Static theming:ThemeColors.DisabledForegroundColor}">#66D5D5D5</Color>
    <Color x:Key="{x:Static theming:ThemeColors.AccentColor}">#4F7FE0</Color> <!-- switches, selection, main buttons -->
    <Color x:Key="{x:Static theming:ThemeColors.AccentForegroundColor}">#FFFFFF</Color> <!-- text on the accent color -->
    <Color x:Key="{x:Static theming:ThemeColors.SuccessColor}">#4CC38A</Color>
    <Color x:Key="{x:Static theming:ThemeColors.WarningColor}">#FFC107</Color>
    <Color x:Key="{x:Static theming:ThemeColors.ErrorColor}">#FF6B6B</Color>

    <!-- Application colors that differ from the defaults in ThemeCommon.xaml -->
    <SolidColorBrush x:Key="AccentTextColor" Color="#7FACFF" />
    <SolidColorBrush x:Key="SuccessBackground" Color="#00661C" />
    <SolidColorBrush x:Key="DisabledColor" Color="#5B5B70" />
    <SolidColorBrush x:Key="SeparatorColor" Color="#1F2029" />
    <SolidColorBrush x:Key="WindowBorderColor" Color="#1F2029" />
</ResourceDictionary>
