<!--
    Light theme. The palette below is all a theme has to define: the control brushes are built from it
    (Theming/ColorSchemes) and the application colors default to it (Themes/ThemeCommon.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:ZenTimings.Theming;assembly=ZenTimings">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ZenTimings;component/Theming/ColorSchemes/Light.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/ThemeCommon.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/SharedAssets.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Resources/vendor/asus/rog/rog-logo-alt.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Resources/vendor/asus/proart/proart-logo-alt.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Resources/vendor/gskill/gskill-logo-alt.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Resources/vendor/biwin/biwin-logo-alt.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Palette -->
    <Color x:Key="{x:Static theming:ThemeColors.BackgroundColor}">#F3F3F3</Color> <!-- window -->
    <Color x:Key="{x:Static theming:ThemeColors.SurfaceColor}">#B3FFFFFF</Color> <!-- cards and group boxes (translucent, so it also works on gradients) -->
    <Color x:Key="{x:Static theming:ThemeColors.PopupColor}">#FBFBFB</Color> <!-- menus, drop-downs, tool tips -->
    <Color x:Key="{x:Static theming:ThemeColors.BorderColor}">#1A000000</Color> <!-- control, card and popup outlines -->
    <Color x:Key="{x:Static theming:ThemeColors.ForegroundColor}">#212529</Color>
    <Color x:Key="{x:Static theming:ThemeColors.SecondaryForegroundColor}">#B8212529</Color>
    <Color x:Key="{x:Static theming:ThemeColors.DisabledForegroundColor}">#61212529</Color>
    <Color x:Key="{x:Static theming:ThemeColors.AccentColor}">#005FB8</Color> <!-- switches, selection, main buttons -->
    <Color x:Key="{x:Static theming:ThemeColors.AccentForegroundColor}">#FFFFFF</Color> <!-- text on the accent color -->
    <Color x:Key="{x:Static theming:ThemeColors.SuccessColor}">#0F7B0F</Color>
    <Color x:Key="{x:Static theming:ThemeColors.WarningColor}">#C27C00</Color>
    <Color x:Key="{x:Static theming:ThemeColors.ErrorColor}">#DD2C00</Color>

    <!-- Application colors that differ from the defaults in ThemeCommon.xaml -->
    <SolidColorBrush x:Key="AccentTextColor" Color="#004B84" />
    <SolidColorBrush x:Key="SeparatorColor" Color="#E5E5E5" />
    <SolidColorBrush x:Key="ContentBackground" Color="#F7F7F7" />
    <SolidColorBrush x:Key="SuccessBackground" Color="#D4EDDA" />
    <SolidColorBrush x:Key="DisabledColor" Color="#A0A0A0" />
    <SolidColorBrush x:Key="WindowBorderColor" Color="#C4C4C4" />
    <SolidColorBrush x:Key="LiveSnapshotBrush" Color="{StaticResource {x:Static theming:ThemeColors.ErrorColor}}" />
</ResourceDictionary>
