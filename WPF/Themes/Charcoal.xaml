<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:ZenTimings.Theming;assembly=ZenTimings">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ZenTimings;component/Theming/ColorSchemes/Dark.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/SharedAssets.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Text color -->
    <Color x:Key="{x:Static theming:ThemeColors.ForegroundColor}">#D7D9DD</Color>

    <!-- Window title background -->
    <Color x:Key="{x:Static theming:ThemeColors.Layer0BorderColor}">#18191C</Color>
    <!-- Window background -->
    <Color x:Key="{x:Static theming:ThemeColors.Layer0BackgroundColor}">#18191C</Color>

    <Color x:Key="{x:Static theming:ThemeColors.Layer3BorderColor}">#101114</Color>

    <!-- Accent button and toggles -->
    <Color x:Key="{x:Static theming:ThemeColors.AccentColor}">#8FA3B8</Color>
    <Color x:Key="{x:Static theming:ThemeColors.AccentForegroundColor}">#18191C</Color>

    <!-- Accent button and toggles hover -->
    <Color x:Key="{x:Static theming:ThemeColors.AccentHighlightColor}">#A3B4C6</Color>
    <!-- Accent button and toggles active -->
    <Color x:Key="{x:Static theming:ThemeColors.AccentInteractionColor}">#B4C2D1</Color>
    <Color x:Key="{x:Static theming:ThemeColors.AccentInteractionBorderColor}">#B4C2D1</Color>
    <Color x:Key="{x:Static theming:ThemeColors.AccentIntenseHighlightBorderColor}">#B4C2D1</Color>

    <!-- Dropdown and menu background -->
    <Color x:Key="{x:Static theming:ThemeColors.Layer1BackgroundColor}">#23252A</Color>
    <Color x:Key="{x:Static theming:ThemeColors.Layer1BorderColor}">#23252A</Color>

    <!-- Dropdown and menu hover background -->
    <Color x:Key="{x:Static theming:ThemeColors.Layer1HighlightColor}">#2D3036</Color>
    <Color x:Key="{x:Static theming:ThemeColors.Layer1HighlightBorderColor}">#393D45</Color>

    <!-- Window button hover color -->
    <Color x:Key="{x:Static theming:ThemeColors.WindowButtonHighlightColor}">#2D3036</Color>

    <Color x:Key="{x:Static theming:ThemeColors.Layer2HighlightColor}">#2D3036</Color>
    <Color x:Key="{x:Static theming:ThemeColors.Layer2HighlightBorderColor}">#2D3036</Color>

    <CornerRadius x:Key="{x:Static theming:ThemeDimensions.CornerRadius}">2</CornerRadius>

    <SolidColorBrush x:Key="AccentTextColor" Color="{StaticResource {x:Static theming:ThemeColors.AccentColor}}" />

    <!-- Panels -->
    <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource {x:Static theming:ThemeColors.Layer0BackgroundColor}}" />
    <SolidColorBrush x:Key="BottomPanelBackground" Color="{StaticResource {x:Static theming:ThemeColors.Layer0BackgroundColor}}" />
    <SolidColorBrush x:Key="MainMenuPanelBackground" Color="{StaticResource {x:Static theming:ThemeColors.Layer0BackgroundColor}}" />
    <SolidColorBrush x:Key="MenuItemBackground" Color="{StaticResource {x:Static theming:ThemeColors.Layer0BackgroundColor}}" />

    <SolidColorBrush x:Key="TextColor" Color="{StaticResource {x:Static theming:ThemeColors.ForegroundColor}}" />
    <SolidColorBrush x:Key="SeparatorColor" Color="{StaticResource {x:Static theming:ThemeColors.Layer3BorderColor}}" />
    <SolidColorBrush x:Key="SuccessBackground" Color="#3B7A57" />
    <SolidColorBrush x:Key="DisabledColor" Color="#5F636B" />
    <SolidColorBrush x:Key="WindowBorderColor" Color="{StaticResource {x:Static theming:ThemeColors.Layer3BorderColor}}" />

    <!-- logo -->
    <SolidColorBrush x:Key="LogoColor" Color="{StaticResource {x:Static theming:ThemeColors.ForegroundColor}}" />
    <SolidColorBrush x:Key="LogoColorAlt" Color="{StaticResource {x:Static theming:ThemeColors.ForegroundColor}}" />
</ResourceDictionary>