<!--
    Charcoal theme. The palette below is all a theme has to define: the control brushes are built from it
    (Theming/ColorSchemes) and the application colors default to it (Themes/ThemeCommon.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:ZenTimings.Theming;assembly=ZenTimings">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ZenTimings;component/Theming/ColorSchemes/Dark.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/ThemeCommon.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/SharedAssets.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Palette -->
    <Color x:Key="{x:Static theming:ThemeColors.BackgroundColor}">#18191C</Color> <!-- window -->
    <Color x:Key="{x:Static theming:ThemeColors.SurfaceColor}">#0DFFFFFF</Color> <!-- cards and group boxes (translucent, so it also works on gradients) -->
    <Color x:Key="{x:Static theming:ThemeColors.PopupColor}">#23252A</Color> <!-- menus, drop-downs, tool tips -->
    <Color x:Key="{x:Static theming:ThemeColors.BorderColor}">#1AFFFFFF</Color> <!-- control, card and popup outlines -->
    <Color x:Key="{x:Static theming:ThemeColors.ForegroundColor}">#D7D9DD</Color>
    <Color x:Key="{x:Static theming:ThemeColors.SecondaryForegroundColor}">#B8D7D9DD</Color>
    <Color x:Key="{x:Static theming:ThemeColors.DisabledForegroundColor}">#66D7D9DD</Color>
    <Color x:Key="{x:Static theming:ThemeColors.AccentColor}">#8FA3B8</Color> <!-- switches, selection, main buttons -->
    <Color x:Key="{x:Static theming:ThemeColors.AccentForegroundColor}">#18191C</Color> <!-- text on the accent color -->
    <Color x:Key="{x:Static theming:ThemeColors.SuccessColor}">#4CC38A</Color>
    <Color x:Key="{x:Static theming:ThemeColors.WarningColor}">#FFC107</Color>
    <Color x:Key="{x:Static theming:ThemeColors.ErrorColor}">#FF6B6B</Color>

    <CornerRadius x:Key="{x:Static theming:ThemeDimensions.CornerRadius}">2</CornerRadius>

    <!-- Application colors that differ from the defaults in ThemeCommon.xaml -->
    <SolidColorBrush x:Key="SeparatorColor" Color="#101114" />
    <SolidColorBrush x:Key="SuccessBackground" Color="#3B7A57" />
    <SolidColorBrush x:Key="DisabledColor" Color="#5F636B" />
    <SolidColorBrush x:Key="WindowBorderColor" Color="#101114" />
</ResourceDictionary>
