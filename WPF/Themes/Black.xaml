<!--
    Black theme. The palette below is all a theme has to define: the control brushes are built from it
    (Theming/ColorSchemes) and the application colors default to it (Themes/ThemeCommon.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:ZenTimings.Theming">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ZenTimings;component/Theming/ColorSchemes/Dark.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/ThemeCommon.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/SharedAssets.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Palette -->
    <Color x:Key="{x:Static theming:ThemeColors.BackgroundColor}">#000000</Color> <!-- window -->
    <Color x:Key="{x:Static theming:ThemeColors.SurfaceColor}">#0AFFFFFF</Color> <!-- cards and group boxes (translucent, so it also works on gradients) -->
    <Color x:Key="{x:Static theming:ThemeColors.PopupColor}">#141414</Color> <!-- menus, drop-downs, tool tips -->
    <Color x:Key="{x:Static theming:ThemeColors.BorderColor}">#1FFFFFFF</Color> <!-- control, card and popup outlines -->
    <Color x:Key="{x:Static theming:ThemeColors.ForegroundColor}">#C9CDD2</Color>
    <Color x:Key="{x:Static theming:ThemeColors.SecondaryForegroundColor}">#9A9FA7</Color>
    <Color x:Key="{x:Static theming:ThemeColors.DisabledForegroundColor}">#66C9CDD2</Color>
    <Color x:Key="{x:Static theming:ThemeColors.AccentColor}">#AFC6DD</Color> <!-- switches, selection, main buttons -->
    <Color x:Key="{x:Static theming:ThemeColors.AccentForegroundColor}">#000000</Color> <!-- text on the accent color -->
    <Color x:Key="{x:Static theming:ThemeColors.SuccessColor}">#4CC38A</Color>
    <Color x:Key="{x:Static theming:ThemeColors.WarningColor}">#FFC107</Color>
    <Color x:Key="{x:Static theming:ThemeColors.ErrorColor}">#FF6B6B</Color>

    <CornerRadius x:Key="{x:Static theming:ThemeDimensions.CornerRadius}">2</CornerRadius>

    <!-- Application colors that differ from the defaults in ThemeCommon.xaml -->
    <SolidColorBrush x:Key="SeparatorColor" Color="#0A0A0A" />
    <SolidColorBrush x:Key="SuccessBackground" Color="#2F6E4F" />
    <SolidColorBrush x:Key="DisabledColor" Color="#6A6F78" />
    <SolidColorBrush x:Key="WindowBorderColor" Color="#0A0A0A" />
    <SolidColorBrush x:Key="LiveSnapshotBrush" Color="{StaticResource {x:Static theming:ThemeColors.ForegroundColor}}" />
</ResourceDictionary>
