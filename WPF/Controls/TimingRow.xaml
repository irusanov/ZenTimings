<UserControl x:Class="ZenTimings.Controls.TimingRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZenTimings.Controls">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="TimingRowLabel" />
            <ColumnDefinition x:Name="ValueColumn" Width="Auto" SharedSizeGroup="TimingRowValue" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LabelBlock"
                   Grid.Column="0"
                   TextAlignment="Right"
                   Text="{Binding Label, RelativeSource={RelativeSource AncestorType={x:Type local:TimingRow}}}"
                   ToolTip="{Binding LabelToolTip, RelativeSource={RelativeSource AncestorType={x:Type local:TimingRow}}}" />

        <TextBlock x:Name="ValueBlock"
                   Grid.Column="1"
                   Style="{DynamicResource ValueStyles}"
                   Text="{Binding Value, RelativeSource={RelativeSource AncestorType={x:Type local:TimingRow}}}"
                   ToolTip="{Binding ValueToolTip, RelativeSource={RelativeSource AncestorType={x:Type local:TimingRow}}}" />
    </Grid>
</UserControl>
