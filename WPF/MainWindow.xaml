<local:ThemedWindow
    xmlns:local="clr-namespace:ZenTimings"
    x:Class="ZenTimings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:ZenTimings.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:theming="clr-namespace:ZenTimings.Theming"
    xmlns:converters="clr-namespace:ZenTimings.Converters"
    xmlns:controls="clr-namespace:ZenTimings.Controls"
    xmlns:export="clr-namespace:ZenTimings.Export"
    mc:Ignorable="d"
    Title="ZenTimings"
    CanSnapToOtherWindows="False"
    SnapIdentifier="MainWindow"
    Width="386"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanMinimize"
    FontSize="11"
    StateChanged="Window_StateChanged"
    SizeChanged="Window_SizeChanged"
    Activated="Window_Activated"
    Loaded="Window_Loaded"
    UseLayoutRounding="True"
    Style="{DynamicResource WindowStyles}"
    Closing="Window_Closing"
    Height="538"
    SizeToContent="WidthAndHeight"
    Language="en-US">

    <!--Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}"/>
    </Window.Style -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border>
        <StackPanel>
            <Border Style="{DynamicResource MainMenuStyles}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="3" />
                    </Grid.ColumnDefinitions>
                    <Menu x:Name="MainMenu" Grid.Column="0" Style="{DynamicResource MenuStyles}">
                        <MenuItem Header="{loc:Text FileMenu}">
                            <MenuItem Header="{loc:Text ExportMenu}" Click="ExportSnapshotMenuItem_Click" />
                            <MenuItem x:Name="menuItemLiveSnapshot" Header="{loc:Text LiveSnapshotMenu}" Click="LiveSnapshotMenuItem_Click" />
                            <Separator Foreground="{DynamicResource PanelBackground}" />
                            <MenuItem Header="{loc:Text ExitMenu}" Click="ExitToolStripMenuItem_Click" />
                        </MenuItem>
                        <MenuItem Header="{loc:Text ToolsMenu}">
                            <MenuItem Header="{loc:Text OptionsMenu}" Click="OptionsToolStripMenuItem_Click" />
                            <Separator Foreground="{DynamicResource PanelBackground}" />
                            <MenuItem
                                Header="{loc:Text SensorsMenu}"
                                Click="TelemetryMonitorToolstripMenuItem_Click"
                                Visibility="{Binding Settings.AdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <MenuItem
                                Header="{loc:Text UclkRatio}"
                                IsCheckable="True"
                                IsChecked="{Binding Settings.ShowUclkRatio, Mode=TwoWay}"
                                Click="UclkRatioMenuItem_Click"
                                Visibility="{Binding Settings.AdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{loc:Text AdvancedInfo}">
                                <MenuItem
                                    Header="{loc:Text System}"
                                    Click="SystemInfoToolstripMenuItem_Click"
                                    Visibility="{Binding Settings.AdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <MenuItem
                                    Header="{loc:Text Timings}"
                                    Click="AdvancedTimingsToolstripMenuItem_Click"
                                    Visibility="{Binding Settings.AdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <MenuItem
                                    Header="SPD"
                                    Click="SpdInfoToolstripMenuItem_Click"
                                    Visibility="{Binding IsSpdInfoAvailable, Mode=OneTime, Converter={StaticResource BoolToVis}}" />
                                <MenuItem
                                    Header="APOB"
                                    Click="ApobInfoToolstripMenuItem_Click"
                                    Visibility="{Binding Settings.AdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <MenuItem
                                    Header="APCB"
                                    Click="ApcbInfoToolstripMenuItem_Click"
                                    Visibility="{Binding Settings.AdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </MenuItem>
                            <Separator Foreground="{DynamicResource PanelBackground}" />
                            <MenuItem Header="{loc:Text DebugMenu}">
                                <MenuItem Header="{loc:Text CreateDebugReportMenu}" Click="DebugToolstripItem_Click" />
                                <MenuItem Header="{loc:Text OpenDebugReportMenu}" Click="OpenDebugLogAsMockWindow_Click" />
                                <Separator Foreground="{DynamicResource PanelBackground}" />
                                <MenuItem Header="{loc:Text DumpApobMenu}" Click="DumpApobTable_Click" />
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="{loc:Text HelpMenu}">
                            <MenuItem Header="{loc:Text AboutMenu}" Click="AboutToolStripMenuItem_Click" />
                            <MenuItem Header="{loc:Text Changelog}" Click="MenuItem_Click_5" />
                            <MenuItem Header="{loc:Text ReportProblemMenu}" Click="ReportProblemMenuItem_Click" />
                            <Separator Foreground="{DynamicResource PanelBackground}" />
                            <MenuItem Header="Discord" Click="MenuItem_Click_2" />
                            <MenuItem Header="GitHub" Click="MenuItem_Click_3" />
                            <MenuItem Header="Google Drive" Click="MenuItem_Click_6" />
                            <Separator Foreground="{DynamicResource PanelBackground}" />
                            <MenuItem Header="{loc:Text DonatePayPal}" Click="MenuItem_Click" />
                            <MenuItem Header="{loc:Text DonateRevolut}" Click="MenuItem_Click_1" />
                            <Separator Foreground="{DynamicResource PanelBackground}" />
                            <MenuItem Header="{loc:Text Am5BiosList}" Click="MenuItem_Click_4" />
                        </MenuItem>
                    </Menu>
                    <!-- Shown while the live snapshot file is being written, so that it is not left on and forgotten -->
                    <Button x:Name="buttonLiveSnapshot"
                            Grid.Column="1"
                            Style="{DynamicResource IconButtonStyle}"
                            Opacity="1"
                            Margin="0,2,4,0"
                            Visibility="Collapsed"
                            Click="LiveSnapshotMenuItem_Click">
                        <controls:AppIcon
                            Kind="IconRecord"
                            IconWidth="12"
                            IconHeight="12"
                            Fill="{DynamicResource LiveSnapshotBrush}" />
                    </Button>
                    <Button x:Name="buttonScreenshot"
                            Grid.Column="2"
                            Width="20"
                            Height="16"
                            BorderThickness="0"
                            Padding="0"
                            Style="{DynamicResource CameraButtonStyle}"
                            Click="ButtonScreenshot_Click"
                            ForceCursor="True"
                            Cursor="Hand">
                        <Image Source="{DynamicResource CameraImage}"
                               Height="16"
                               Width="16"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <Border Style="{DynamicResource Separator}" />

            <!-- System Info Panel -->
            <Border Style="{DynamicResource PanelStyles}"
                    Visibility="{Binding Settings.AdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical">
                        <TextBlock
                            x:Name="labelCPU"
                            Text="{Binding CpuNameShortWithCores, Mode=OneTime, FallbackValue='CPU: N/A'}"
                            Padding="12 5 5 0"
                        />
                        <TextBlock
                            x:Name="labelMB"
                            Text="{Binding MotherboardInfo, Mode=OneWay, FallbackValue={loc:Text MotherboardUnavailable}}"
                            Padding="12 0 5 5"
                        />
                        <TextBlock
                            x:Name="labelAgesaVersion"
                            Text="{Binding AgesaVersion, Mode=Default, FallbackValue='AGESA: N/A'}"
                            Visibility="{Binding IsAgesaVersionVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            Padding="12 0 5 5"
                            Margin="0 -5 0 0"
                        />
                    </StackPanel>
                    <Border Padding="0 0 5 0" Grid.Column="2"
                            Visibility="{Binding IsMotherboardLogoVisible, Mode=OneTime, Converter={StaticResource BoolToVis}}">

                        <Button
                            BorderThickness="0"
                            Padding="0"
                            Style="{DynamicResource CameraButtonStyle}"
                            ForceCursor="True"
                            Cursor="Hand"
                            Click="MotherboardLinkButton_Click"
                            ToolTip="{Binding MotherboardLogoTooltip, Mode=OneTime}">
                            <Image
                               x:Name="motherboardLogoImage"
                               Height="40"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{DynamicResource Separator}"
                    Visibility="{Binding Settings.AdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <StackPanel x:Name="timingsPanelSlot" Margin="0" Orientation="Vertical" />

            <Border Style="{DynamicResource Separator}" />

            <Border Style="{DynamicResource BottomPanelStyles}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <Button 
                            x:Name="buttonAllDimms"
                            DockPanel.Dock="Right"
                            Content="{loc:Text All}"
                            Margin="4 0 0 0"
                            ToolTip="{loc:Text AllChannelsSideBySide}"
                            Visibility="Collapsed"
                            Click="ButtonAllDimms_Click" />
                        <ComboBox x:Name="comboBoxPartNumber" IsReadOnly="True" IsEnabled="False" />
                    </DockPanel>

                    <StackPanel 
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding Settings.AdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <!-- Opens the all-channels view. Enabled from code when there is more than one module;
                        the label takes the button's state, so it shows the accent colour only while clickable. -->
                        <TextBlock
                            Text="ECC"
                            Style="{DynamicResource ValueStyles}"
                            TextAlignment="Right"
                            Margin="0,0,5,0"
                            MinWidth="35"
                            Visibility="{Binding ECC, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            IsEnabled="True"
                            ToolTip="{loc:Text EccDetected}"
                        />
                    </StackPanel>

                    <!-- Button Grid.Column="1"
                            Width="20"
                            Height="16"
                            BorderThickness="0"
                            Padding="0"
                            Style="{DynamicResource CameraButtonStyle}"
                            ForceCursor="True"
                            Cursor="Hand"
                            Visibility="Hidden"
                            HorizontalAlignment="Right">
                        <Image Source="{DynamicResource WarningImage}"
                               Height="16"
                               Width="16"
                               Stretch="None"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Button-->
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</local:ThemedWindow>