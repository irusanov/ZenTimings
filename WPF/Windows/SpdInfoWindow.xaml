<local:ThemedAdonisWindow
    xmlns:local="clr-namespace:ZenTimings"
    x:Class="ZenTimings.Windows.SpdInfoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    adonisExtensions:CursorSpotlightExtension.RelativeSpotlightSize="0"
    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
    mc:Ignorable="d"
    Title="SPD Information"
    Height="400"
    Width="450"
    MinWidth="400"
    MinHeight="300"
    WindowStartupLocation="CenterOwner"
    BorderThickness="1"
    UseLayoutRounding="True"
    Style="{DynamicResource WindowStyles}">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="10" Style="{DynamicResource PanelStyles}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="DIMM Slot"
                           Style="{StaticResource LabelStyle}"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="ComboSlots"
                          Grid.Column="1"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Index"
                          SelectionChanged="ComboSlots_SelectionChanged"/>

                <Button x:Name="ButtonDumpSpd"
                        Grid.Column="3"
                        Content="Dump SPD"
                        Padding="10,4"
                        Click="ButtonDumpSpd_Click"/>

            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{DynamicResource Separator}"/>

        <!-- Tab control -->
        <TabControl x:Name="ProfilesTabControl"
                    Margin="10"
                    Grid.Row="2"
                    BorderThickness="0">

            <TabItem x:Name="GeneralTab" Header="General">
                <DataGrid x:Name="GeneralGrid"
                          AutoGenerateColumns="False"
                          HeadersVisibility="None"
                          GridLinesVisibility="None"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          IsReadOnly="True"
                          Focusable="False"
                          ScrollViewer.CanContentScroll="True"
                          FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="240" Binding="{Binding Name}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                    <Setter Property="Opacity" Value="0.75"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="*" Binding="{Binding Value}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Style="{DynamicResource Separator}"/>

        <!-- Status bar -->
        <Border Grid.Row="4" Style="{DynamicResource BottomPanelStyles}">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       Style="{StaticResource LabelStyle}"
                       Opacity="0.75"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</local:ThemedAdonisWindow>
