<local:ThemedWindow
    xmlns:local="clr-namespace:ZenTimings"
    xmlns:theming="clr-namespace:ZenTimings.Theming"
    x:Class="ZenTimings.Windows.SystemInfoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:ZenTimings.Controls"
    mc:Ignorable="d"
    Title="System Info"
    SnapIdentifier="SystemInfoWindow"
    Height="450"
    Width="800"
    WindowStartupLocation="CenterOwner"
    BorderThickness="1"
    UseLayoutRounding="True"
    Style="{DynamicResource WindowStyles}"
    Activated="Window_Activated"
    Icon="/ZenTimings;component/Resources/new-icon/16.png"
    Closing="Window_Closing">

    <Window.Resources>
        <!-- Section header with a button that copies the grid the section names in its Tag -->
        <DataTemplate x:Key="CopyHeaderTemplate">
            <DockPanel>
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                <Button Style="{DynamicResource IconButtonStyle}"
                        Margin="4,2,0,0"
                        ToolTip="Copy to clipboard"
                        Click="CopySection_Click"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right">
                    <controls:AppIcon Kind="IconCopy" IconWidth="11" IconHeight="11" Fill="{DynamicResource TextColor}" />
                </Button>
            </DockPanel>
        </DataTemplate>

        <SolidColorBrush x:Key="TimingMismatchBrush" Color="{DynamicResource {x:Static theming:ThemeColors.AlertColor}}"/>
        <SolidColorBrush x:Key="TimingMismatchBackgroundBrush" Color="{DynamicResource {x:Static theming:ThemeColors.AlertColor}}" Opacity="0.16"/>

        <Style x:Key="TimingRowStyle" TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                    <Setter Property="Background" Value="{StaticResource TimingMismatchBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimingNameTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TimingMismatchBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimingValueTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TimingMismatchBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer Padding="0" Margin="0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel CanVerticallyScroll="False">
            <GroupBox
                Header="SystemInfo"
                HeaderTemplate="{StaticResource CopyHeaderTemplate}"
                Tag="{x:Reference TestGrid}"
                theming:LayerExtension.Layer="3"
                Padding="10 5">
                <DataGrid
                    Name="TestGrid"
                    AutoGenerateColumns="False"
                    HeadersVisibility="None"
                    GridLinesVisibility="None"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Disabled"
                    Focusable="False"
                    IsReadOnly="True"
                    ScrollViewer.CanContentScroll="False"
                    IsEnabled="False" FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="150" Binding="{Binding Name}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="auto" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox
                Header="Memory Timings"
                HeaderTemplate="{StaticResource CopyHeaderTemplate}"
                Tag="{x:Reference MemCfgGrid}"
                theming:LayerExtension.Layer="3">
                <DataGrid
                    Name="MemCfgGrid"
                    theming:LayerExtension.Layer="3"
                    AutoGenerateColumns="False"
                    HeadersVisibility="Column"
                    GridLinesVisibility="None"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Disabled"
                    Focusable="False"
                    IsReadOnly="True"
                    ScrollViewer.CanContentScroll="False"
                    RowStyle="{StaticResource TimingRowStyle}"
                    IsEnabled="False" FontSize="11">
                    <!--DataGrid.Columns>
                        <DataGridTextColumn Width="150" Binding="{Binding Name}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="auto" Binding="{Binding Value}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns-->
                </DataGrid>
            </GroupBox>

            <GroupBox
                Header="AOD Table"
                HeaderTemplate="{StaticResource CopyHeaderTemplate}"
                Tag="{x:Reference MemControllerGrid}"
                theming:LayerExtension.Layer="3">
                <DataGrid
                    Name="MemControllerGrid"
                    theming:LayerExtension.Layer="3"
                    AutoGenerateColumns="False"
                    HeadersVisibility="None"
                    GridLinesVisibility="None"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Disabled"
                    Focusable="False"
                    IsReadOnly="True"
                    ScrollViewer.CanContentScroll="False"
                    IsEnabled="False" FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="150" Binding="{Binding Name}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="auto" Binding="{Binding Value}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox
                Header="APOB Table"
                HeaderTemplate="{StaticResource CopyHeaderTemplate}"
                Tag="{x:Reference ApobTableGrid}"
                theming:LayerExtension.Layer="3">
                <DataGrid
                    Name="ApobTableGrid"
                    theming:LayerExtension.Layer="3"
                    AutoGenerateColumns="False"
                    HeadersVisibility="None"
                    GridLinesVisibility="None"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Disabled"
                    Focusable="False"
                    IsReadOnly="True"
                    ScrollViewer.CanContentScroll="False"
                    IsEnabled="False" FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="150" Binding="{Binding Name}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="auto" Binding="{Binding Value}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding asusSensors.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding asusSensors}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <GroupBox
                    Header="Asus WMI"
                    HeaderTemplate="{StaticResource CopyHeaderTemplate}"
                    Tag="{x:Reference AsusWmiGrid}"
                    theming:LayerExtension.Layer="3">

                    <DataGrid
                        Name="AsusWmiGrid"
                        theming:LayerExtension.Layer="3"
                        AutoGenerateColumns="False"
                        HeadersVisibility="None"
                        GridLinesVisibility="None"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Disabled"
                        Focusable="False"
                        IsReadOnly="True"
                        ScrollViewer.CanContentScroll="False"
                        IsEnabled="False" FontSize="11"
                        ItemsSource="{Binding asusSensors}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="150" Binding="{Binding Name}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="auto" Binding="{Binding Value}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:ThemedWindow>