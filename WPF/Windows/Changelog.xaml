<local:ThemedAdonisWindow
    xmlns:local="clr-namespace:ZenTimings"
    xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
    x:Class="ZenTimings.Windows.Changelog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    adonisExtensions:CursorSpotlightExtension.RelativeSpotlightSize="0"
    xmlns:converters="clr-namespace:ZenTimings.Converters"
    mc:Ignorable="d"
    Style="{DynamicResource WindowStyles}"
    Title="What's New"
    Height="580"
    Width="454"
    UseLayoutRounding="True"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Topmost="True" Icon="/ZenTimings;component/Resources/new-icon/16.png"
    SizeToContent="WidthAndHeight">

    <Window.Resources>
        <converters:DDR5ToVisConverter x:Key="DDR5ToBool" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Vertical" Margin="15,15,5,15" Grid.ColumnSpan="6" Grid.Row="0" Width="424">
                <!-- TextBlock Text="Changelog" FontSize="14" FontWeight="Bold" Style="{DynamicResource ValueStyles}" Height="auto" HorizontalAlignment="Left" /-->
                <TextBlock Text="v1.40" FontSize="13" Style="{DynamicResource ValueStyles}" Height="auto" HorizontalAlignment="Left" Margin="0" />

                <TextBlock Text="" />
                <TextBlock Text=" - Added CCD_L timings for DDR5 in advanced mode" TextWrapping="WrapWithOverflow" />
                <TextBlock Text=" - Renamed Telemetry window to Sensors and enabled it for all systems" TextWrapping="WrapWithOverflow" />
                <TextBlock Text=" - Added a sensor management dialog to show/hide individual sensors" TextWrapping="WrapWithOverflow" />
                <TextBlock Text=" - Added icons for sensors" TextWrapping="WrapWithOverflow" />
                <TextBlock Text=" - Sensors window now keeps updating while the main window is minimized" TextWrapping="WrapWithOverflow" />
                <TextBlock Text=" - Bind VSOC and VDDIO to SuperIO when available, falling back to PMT" TextWrapping="WrapWithOverflow" />
                <TextBlock Text=" - Added autostart option" TextWrapping="WrapWithOverflow" />
                <TextBlock Text=" - Added automatic inpoutx64 driver cleanup on app close (toggle from Options)" TextWrapping="WrapWithOverflow" />
                <TextBlock Text=" - Added icons to sections in the options dialog" TextWrapping="WrapWithOverflow" />
                <TextBlock Text=" - Fixed telemetry/sensors window alarm colors not recording max values" TextWrapping="WrapWithOverflow" />
                <TextBlock Text=" - Fixed incorrect read function used for SVI2 planes (Zen3 and earlier)" TextWrapping="WrapWithOverflow" />
                <TextBlock Text=" - Fixed incorrect handling of corner radius (W11)" TextWrapping="WrapWithOverflow" />
                <TextBlock Text=" - Unmatched Hynix dies are now displayed as 'Unknown' instead of an incorrect value" TextWrapping="WrapWithOverflow" />
                <TextBlock Text=" - Removed the maximize button when maximizing is not applicable" TextWrapping="WrapWithOverflow" />
                <TextBlock Text=" - Added SuperIO hardware support, ported from LibreHardwareMonitor" TextWrapping="WrapWithOverflow" />
                <TextBlock Text=" - Updated DDR5 UMC timings with additional entries" TextWrapping="WrapWithOverflow" />
                <TextBlock Text=" - Extended data in Debug report" TextWrapping="WrapWithOverflow" />
            </StackPanel>
            <Border Padding="4 10" Grid.ColumnSpan="6" Grid.Row="2">
                <Button x:Name="Changelog_Close" Content="OK" Width="80" IsCancel="True" />
            </Border>
        </Grid>
    </ScrollViewer>
</local:ThemedAdonisWindow>
