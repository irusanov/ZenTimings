<local:ThemedWindow
    xmlns:local="clr-namespace:ZenTimings"
    xmlns:theming="clr-namespace:ZenTimings.Theming"
    x:Class="ZenTimings.Windows.Changelog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:ZenTimings.Converters"
    xmlns:controls="clr-namespace:ZenTimings.Controls"
    mc:Ignorable="d"
    Style="{DynamicResource WindowStyles}"
    Title="What's New"
    MaxHeight="580"
    Width="500"
    UseLayoutRounding="True"
    ResizeMode="CanResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    Topmost="True" Icon="/ZenTimings;component/Resources/new-icon/16.png">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Vertical" Margin="15,15,5,15" Grid.ColumnSpan="6" Grid.Row="0">
                    <!-- @TODO: add binding to show beta text on BETA builds only -->
                    <!--TextBlock 
                        Text="Welcome to our BETA version. You might run into a few bugs or features that aren't working quite right just yet. If you spot anything unexpected, please let us know so we can fix it!"
                        Foreground="{DynamicResource {x:Static theming:ThemeBrushes.WarningBrush}}"
                        HorizontalAlignment="Left"
                        Padding="0, 0, 0, 14"
                        TextWrapping="WrapWithOverflow" /-->

                    <!--TextBlock 
                        Text="This version contains many changes and has been tested on a limited set of configurations. You might run into a few bugs or features that aren't working quite right just yet. If you spot anything unexpected, please let us know so we can fix it!"
                        Foreground="{DynamicResource {x:Static theming:ThemeBrushes.WarningBrush}}"
                        HorizontalAlignment="Left"
                        Padding="0, 0, 0, 14"
                        TextWrapping="WrapWithOverflow" /-->

                    <!-- TextBlock Text="Changelog" FontSize="14" FontWeight="Bold" Style="{DynamicResource ValueStyles}" Height="auto" HorizontalAlignment="Left" /-->
                    <TextBlock Text="{Binding Version, Mode=OneWay}" FontSize="13" Style="{DynamicResource ValueStyles}" Height="auto" HorizontalAlignment="Left" Margin="0,0,0,4" />

                    <controls:ChangelogItem Text="Fixed issue with reading SPD5118 hub (IDT/Renesas)" />
                    <controls:ChangelogItem Text="Removed the AdonisUI dependency while keeping the existing themes, with refreshed theme colors and more consistent styles across windows" />
                    <controls:ChangelogItem Text="The splash screen now shows core initialization progress" />
                    <controls:ChangelogItem Text="Added DDR4 SPD and DIMM thermal sensor support" />
                    <controls:ChangelogItem Text="Improved DDR5 SPD reading and redesigned the SPD and PMIC window, including EXPO extended timings" />
                    <controls:ChangelogItem Text="Extended APOB tables (now with DDR4 support) and added a new APOB window under Advanced Info" />
                    <controls:ChangelogItem Text="Added experimental reading of Vref values - available in Debug log and APOB and System windows (Tools -> Advanced Info)" />
                    <controls:ChangelogItem Text="Replaced BGS Alt with PowerDown; tCCDL is now shown as part of a combined value" />
                    <controls:ChangelogItem Text="Optional UCLK to MCLK ratio shown next to UCLK, toggled from the Tools menu (idea by @deadfellow34, PR#109 by @b1zya)" />
                    <controls:ChangelogItem Text="BurstLength and BurstCtrl are now decoded as readable text in the Advanced Timings window and debug report" />
                    <controls:ChangelogItem Text="VDDIO read from SuperIO is checked for a valid range, with a fallback to AOD if not. It can still be wrong on unsupported motherboards" />
                    <controls:ChangelogItem Text="Mismatched timings between channels are highlighted with neutral accent colors" />
                    <controls:ChangelogItem Text="DIMM info blocks can now be hidden in the Sensors window, plus several other QoL improvements" />
                    <controls:ChangelogItem Text="Fixed the Advanced Timings window not remembering its size and position" />
                    <controls:ChangelogItem Text="Improved the driver cleanup notification and fixed it blocking a new instance of the app from starting" />
                    <controls:ChangelogItem Text="SPD dumps now use a more descriptive filename" />
                    <controls:ChangelogItem Text="Fixed ASUS WMI resources not being released" />
                    <controls:ChangelogItem Text="Rendering and performance improvements" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Border Padding="4 10" Grid.Row="1">
            <Button x:Name="Changelog_Close" Content="OK" Width="80" IsCancel="True" />
        </Border>
    </Grid>
</local:ThemedWindow>
