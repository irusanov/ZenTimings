<local:ThemedWindow
    xmlns:local="clr-namespace:ZenTimings"
    xmlns:theming="clr-namespace:ZenTimings.Theming"
    x:Class="ZenTimings.Windows.Changelog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:ZenTimings.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:ZenTimings.Converters"
    xmlns:controls="clr-namespace:ZenTimings.Controls"
    mc:Ignorable="d"
    Style="{DynamicResource WindowStyles}"
    Title="{loc:Text WhatsNew}"
    MaxHeight="580"
    Width="500"
    UseLayoutRounding="True"
    ResizeMode="CanResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    Topmost="True" Icon="/ZenTimings;component/Resources/new-icon/16.png">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Vertical" Margin="15,15,5,15" Grid.ColumnSpan="6" Grid.Row="0">
                    <!-- @TODO: add binding to show beta text on BETA builds only -->
                    <!--TextBlock 
                        Text="Welcome to our BETA version. You might run into a few bugs or features that aren't working quite right just yet. If you spot anything unexpected, please let us know so we can fix it!"
                        Foreground="{DynamicResource {x:Static theming:ThemeBrushes.WarningBrush}}"
                        HorizontalAlignment="Left"
                        Padding="0, 0, 0, 14"
                        TextWrapping="WrapWithOverflow" /-->

                    <!--TextBlock 
                        Text="This version contains many changes and has been tested on a limited set of configurations. You might run into a few bugs or features that aren't working quite right just yet. If you spot anything unexpected, please let us know so we can fix it!"
                        Foreground="{DynamicResource {x:Static theming:ThemeBrushes.WarningBrush}}"
                        HorizontalAlignment="Left"
                        Padding="0, 0, 0, 14"
                        TextWrapping="WrapWithOverflow" /-->

                    <!-- TextBlock Text="Changelog" FontSize="14" FontWeight="Bold" Style="{DynamicResource ValueStyles}" Height="auto" HorizontalAlignment="Left" /-->
                    <TextBlock Text="{Binding Version, Mode=OneWay}" FontSize="13" Style="{DynamicResource ValueStyles}" Height="auto" HorizontalAlignment="Left" Margin="0,0,0,4" />

                    <TextBlock Text="{loc:Text Application}" FontWeight="SemiBold" Style="{DynamicResource ValueStyles}" Height="auto" HorizontalAlignment="Left" Margin="0,6,0,2" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogSendDebugReport}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogDebugUi}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogModulesDropdown}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogBackgroundSpd}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogSpdVendors}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogRefreshHighlight}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogReleaseChannel}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogAntivirus}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogSettingsBackup}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogUpdater}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogStartupWarning}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogPowerTableResume}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogExit}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogApcbWindow}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogKeepDriverInUse}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogPawnIoPrompt}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogWmiSensors}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogReportWmi}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogHideDriverError}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogBclkSensors}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogSensorColumns}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogWheaCounter}" />

                    <TextBlock Text="{loc:Text Core}" FontWeight="SemiBold" Style="{DynamicResource ValueStyles}" Height="auto" HorizontalAlignment="Left" Margin="0,10,0,2" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogRfcDimm}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogApuPstate}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogRefreshDetection}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogDdr5TimingDetection}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogApobTimingBlock}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogPowerTableRefresh}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogAgesa}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogApobDfPstate}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogPerformance}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogSuperIoBoards}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogApcbDebugReport}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogApobTraining}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogApobAddress}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogApobDdr4}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogWmiSensorGroup}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogApobDriver}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogBclkMemory}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogBclkMode}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogBclkValues}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogBclkClass}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogSuperIoX570E}" />
                    <controls:ChangelogItem Text="{loc:Text ChangelogSuperIoVdimm}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Border Padding="4 10" Grid.Row="1">
            <Button x:Name="Changelog_Close" Content="{loc:Text OK}" Width="80" IsCancel="True" />
        </Border>
    </Grid>
</local:ThemedWindow>
