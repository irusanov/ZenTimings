<local:ThemedAdonisWindow
    xmlns:local="clr-namespace:ZenTimings"
    x:Class="ZenTimings.Windows.OptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:controls="clr-namespace:ZenTimings.Controls"
    adonisExtensions:CursorSpotlightExtension.RelativeSpotlightSize="0"
    mc:Ignorable="d"
    x:Name="OptionsWindow"
    Title="Options"
    Height="560"
    Width="450"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Icon="/ZenTimings;component/Resources/new-icon/16.png"
    SizeToContent="WidthAndHeight"
    ShowInTaskbar="False"
    BorderThickness="1"
    UseLayoutRounding="True"
    Style="{DynamicResource WindowStyles}"
    Closing="OptionsWindow_Closing">

    <local:ThemedAdonisWindow.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Padding" Value="4 3" />
        </Style>
        <Style x:Key="SectionIcon" TargetType="controls:AppIcon">
            <Setter Property="IconWidth" Value="12" />
            <Setter Property="IconHeight" Value="12" />
            <Setter Property="Fill" Value="{DynamicResource TextColor}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0 3 4 3" />
        </Style>
        <Style x:Key="SectionHeaderPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>
        <Style x:Key="SectionPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Margin" Value="6 2" />
        </Style>
        <Style x:Key="SectionGrid" TargetType="Grid">
            <Setter Property="Margin" Value="20 4 8 4" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0 2 5 2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Static adonisUi:Styles.ToggleSwitch}}">
            <Setter Property="Margin" Value="0 2 5 2" />
        </Style>
        <Style x:Key="SettingCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="5 4 0 4" />
            <Setter Property="Width" Value="151" />
        </Style>
    </local:ThemedAdonisWindow.Resources>

    <StackPanel x:Name="OptionWindowContent" Margin="4 0">
        <Popup
            x:Name="OptionsPopup"
            Panel.ZIndex="100"
            PlacementTarget="{Binding ElementName=OptionWindowContent}"
            VerticalAlignment="Center"
            Placement="Relative"
            HorizontalAlignment="Center"
            VerticalOffset="0"
            AllowsTransparency="True"
            Opacity="0.8"
            PopupAnimation="Fade"
            ClipToBounds="True"
            StaysOpen="False"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            MouseDown="OptionsPopup_MouseDown">
            <TextBlock
                Name="OptionsPopupText"
                Background="{DynamicResource SuccessBackground}"
                Padding="10" Opacity="0.95">
                Settings Saved.
            </TextBlock>
        </Popup>

        <!-- General -->
        <StackPanel Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <controls:AppIcon Kind="IconGeneral" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="General" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />
            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <ToggleButton
                    x:Name="checkBoxAdvancedMode"
                    Grid.Column="0"
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="Advanced mode"
                    Click="CheckBoxAdvancedMode_Click" />

                <ToggleButton
                    x:Name="checkBoxAutoRefresh"
                    Grid.Column="0"
                    Grid.Row="1"
                    Content="Auto refresh"
                    Style="{StaticResource SettingToggle}"
                    Click="CheckBoxAutoRefresh_Click" />

                <controls:NumericTextBox
                    x:Name="numericUpDownRefreshInterval"
                    Minimum="20"
                    Grid.Column="1"
                    Grid.Row="1"
                    Margin="5 0 5 0" />

                <Label
                    x:Name="msText"
                    Grid.Column="2"
                    Grid.Row="1"
                    Content="ms"
                    VerticalAlignment="Center"
                    Padding="5 0" FontWeight="Normal" />

                <ToggleButton
                    x:Name="checkBoxCheckUpdate"
                    Grid.Column="0"
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="Check for updates" />

                <ToggleButton
                    x:Name="checkBoxBetaUpdates"
                    Grid.Column="0"
                    Grid.Row="3"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="Participate in beta updates" />

                <ToggleButton
                    x:Name="checkBoxSingleInstance"
                    Grid.Column="0"
                    Grid.Row="4"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="Single instance" />
            </Grid>
        </StackPanel>

        <!-- Appearance -->
        <StackPanel Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <controls:AppIcon Kind="IconAppearance" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />
            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Grid.Row="0"
                    Style="{StaticResource SettingLabel}"
                    Text="Theme" />
                <ComboBox
                    x:Name="comboBoxTheme"
                    Grid.ColumnSpan="2"
                    Grid.Column="1"
                    Grid.Row="0"
                    Style="{StaticResource SettingCombo}"
                    SelectionChanged="ComboBoxTheme_SelectionChanged">
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                    <ComboBoxItem Content="Dark Mint" />
                    <ComboBoxItem Content="Dark Mint Gradient" />
                    <ComboBoxItem Content="Asus ROG" />
                    <ComboBoxItem Content="Dracula" />
                    <ComboBoxItem Content="Retro Wave" />
                    <ComboBoxItem Content="Burnt Orange" />
                    <ComboBoxItem Content="Black" />
                </ComboBox>

                <TextBlock
                    Grid.Column="0"
                    Grid.Row="1"
                    Style="{StaticResource SettingLabel}"
                    Text="Corner radius (Win 11)" />
                <ComboBox
                    x:Name="comboBoxCornerRadius"
                    Grid.ColumnSpan="2"
                    Grid.Column="1"
                    Grid.Row="1"
                    Style="{StaticResource SettingCombo}">
                    <ComboBoxItem Content="Auto" />
                    <ComboBoxItem Content="No Radius" />
                    <ComboBoxItem Content="Default Radius" />
                    <ComboBoxItem Content="Small Radius" />
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- Sensors -->
        <StackPanel Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <controls:AppIcon Kind="IconTemperature" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="Sensors" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />
            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Grid.Row="0"
                    Style="{StaticResource SettingLabel}"
                    Text="Impedance table source" />
                <ComboBox
                    x:Name="comboBoxImpedanceSource"
                    Grid.ColumnSpan="2"
                    Grid.Column="1"
                    Grid.Row="0"
                    Style="{StaticResource SettingCombo}">
                    <ComboBoxItem Content="Legacy" />
                    <ComboBoxItem Content="Extended" />
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- Startup & Window -->
        <StackPanel Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <controls:AppIcon Kind="IconStartup" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="Startup &amp; Window" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />
            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <ToggleButton
                    x:Name="checkBoxAutostart"
                    Grid.Column="0"
                    Grid.Row="0"
                    Style="{StaticResource SettingToggle}"
                    Content="Autostart on logon"
                    Click="CheckBoxAutostart_Click" />

                <controls:NumericTextBox
                    x:Name="numericUpDownAutostartDelay"
                    Grid.Column="1"
                    Grid.Row="0"
                    Margin="5 0 5 0" />

                <Label
                    x:Name="secText"
                    Grid.Column="2"
                    Grid.Row="0"
                    Content="sec"
                    VerticalAlignment="Center"
                    Padding="5 0" FontWeight="Normal" />

                <ToggleButton
                    x:Name="checkBoxStartMinimized"
                    Grid.Column="0"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="Start minimized" />

                <ToggleButton
                    x:Name="checkBoxMinimizeToTray"
                    Content="Minimize to tray"
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}" />

                <ToggleButton
                    x:Name="checkBoxSavePosition"
                    Grid.Column="0"
                    Grid.Row="3"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="Save position on app close" />
            </Grid>
        </StackPanel>

        <!-- Driver -->
        <StackPanel Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <controls:AppIcon Kind="IconDriver" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="Driver" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />

            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <ToggleButton
                    x:Name="checkBoxAutoUninstallDriver"
                    Grid.Column="0"
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="Uninstall inpoutx64 driver on close" />

                <TextBlock
                    Grid.Column="0"
                    Grid.Row="1"
                    Style="{StaticResource SettingLabel}"
                    Text="Uninstall notifications" />

                <ComboBox
                    x:Name="comboBoxDriverNotification"
                    Grid.Column="1"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource SettingCombo}"
                    IsEnabled="{Binding IsChecked, ElementName=checkBoxAutoUninstallDriver}">
                    <ComboBoxItem Content="None" />
                    <ComboBoxItem Content="Errors only" />
                    <ComboBoxItem Content="All" />
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- Screenshot -->
        <StackPanel Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <controls:AppIcon Kind="IconScreenshot" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="Screenshot" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />
            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Grid.Row="0"
                    Style="{StaticResource SettingLabel}"
                    Text="Mode" />
                <ComboBox
                    x:Name="comboBoxScreenshot"
                    Grid.ColumnSpan="2"
                    Grid.Column="1"
                    Grid.Row="0"
                    Style="{StaticResource SettingCombo}">
                    <ComboBoxItem Content="App Window" />
                    <ComboBoxItem Content="Full Desktop" />
                </ComboBox>

                <TextBlock
                    x:Name="screenshotPath"
                    Grid.Column="0"
                    Grid.Row="1"
                    Style="{StaticResource SettingLabel}"
                    Text="Location" />

                <TextBox
                    x:Name="textBoxScreenshotPath"
                    Grid.Column="1"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="3 0 0 0"
                    Width="151"
                    IsReadOnly="True"
                    VerticalAlignment="Top" />

                <Button
                    x:Name="buttonBrowseScreenshotPath"
                    Grid.Column="3"
                    Grid.Row="1"
                    Content="Browse..."
                    Margin="5 0 0 0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Click="ButtonBrowseScreenshotPath_Click" />
            </Grid>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="buttonSettingsRestart"
                Grid.Column="0"
                Content="Restart"
                Visibility="Hidden"
                Margin="6 6 0 6"
                Width="70"
                Click="ButtonSettingsRestart_Click" />

            <Button
                x:Name="buttonSettingsApply"
                Grid.Column="2"
                Content="Apply"
                Margin="6 6 0 6"
                Style="{DynamicResource {x:Static adonisUi:Styles.AccentButton}}"
                Width="70"
                Click="ButtonSettingsApply_Click" />

            <Button
                x:Name="buttonSettingsCancel"
                Grid.Column="3"
                Content="Close"
                IsCancel="True"
                Width="70"
                Margin="6"
                Click="ButtonSettingsCancel_Click" />
        </Grid>
    </StackPanel>
</local:ThemedAdonisWindow>
