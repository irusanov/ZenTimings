<local:ThemedAdonisWindow
    xmlns:local="clr-namespace:ZenTimings"
    x:Class="ZenTimings.Windows.OptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
    adonisExtensions:CursorSpotlightExtension.RelativeSpotlightSize="0"
    mc:Ignorable="d"
    x:Name="OptionsWindow"
    Title="Options"
    Height="560"
    Width="450"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Icon="/ZenTimings;component/Resources/new-icon/16.png"
    SizeToContent="WidthAndHeight"
    ShowInTaskbar="False"
    BorderThickness="1"
    UseLayoutRounding="True"
    Style="{DynamicResource WindowStyles}"
    Closing="OptionsWindow_Closing">

    <local:ThemedAdonisWindow.Resources>
        <!-- Section header icons -->
        <Geometry x:Key="IconGeneral">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.53,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.72,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.9,2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.72,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.53,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</Geometry>
        <Geometry x:Key="IconAppearance">M12,2C6.49,2 2,6.49 2,12C2,17.51 6.49,22 12,22C13.38,22 14.5,20.88 14.5,19.5C14.5,18.83 14.24,18.23 13.81,17.79C13.39,17.36 13.13,16.76 13.13,16.11C13.13,14.73 14.25,13.61 15.63,13.61H17.5C19.99,13.61 22,11.6 22,9.11C22,5.03 17.51,2 12,2M6.5,12C5.67,12 5,11.33 5,10.5C5,9.67 5.67,9 6.5,9C7.33,9 8,9.67 8,10.5C8,11.33 7.33,12 6.5,12M9.5,8C8.67,8 8,7.33 8,6.5C8,5.67 8.67,5 9.5,5C10.33,5 11,5.67 11,6.5C11,7.33 10.33,8 9.5,8M14.5,8C13.67,8 13,7.33 13,6.5C13,5.67 13.67,5 14.5,5C15.33,5 16,5.67 16,6.5C16,7.33 15.33,8 14.5,8M17.5,12C16.67,12 16,11.33 16,10.5C16,9.67 16.67,9 17.5,9C18.33,9 19,9.67 19,10.5C19,11.33 18.33,12 17.5,12Z</Geometry>
        <Geometry x:Key="IconTemperature">M15,13V5A3,3 0 0,0 12,2A3,3 0 0,0 9,5V13A5,5 0 0,0 12,22A5,5 0 0,0 15,13M12,4A1,1 0 0,1 13,5V13.5L13.5,14A3,3 0 0,1 12,20A3,3 0 0,1 10.5,14L11,13.5V5A1,1 0 0,1 12,4Z</Geometry>
        <Geometry x:Key="IconStartup">M16,7V3H14V7H10V3H8V7H7.5A1.5,1.5 0 0,0 6,8.5V12.5A6,6 0 0,0 10,18.08V22H14V18.08A6,6 0 0,0 18,12.5V8.5A1.5,1.5 0 0,0 16.5,7H16Z</Geometry>
        <Geometry x:Key="IconScreenshot">M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z</Geometry>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Padding" Value="4 3" />
        </Style>
        <Style x:Key="SectionIcon" TargetType="Path">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{DynamicResource TextColor}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0 3 4 3" />
        </Style>
        <Style x:Key="SectionHeaderPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>
        <Style x:Key="SectionPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Margin" Value="6 2" />
        </Style>
        <Style x:Key="SectionGrid" TargetType="Grid">
            <Setter Property="Margin" Value="20 4 8 4" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0 2 5 2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Static adonisUi:Styles.ToggleSwitch}}">
            <Setter Property="Margin" Value="0 2 5 2" />
        </Style>
        <Style x:Key="SettingCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="5 4 0 4" />
            <Setter Property="Width" Value="151" />
        </Style>
    </local:ThemedAdonisWindow.Resources>

    <StackPanel x:Name="OptionWindowContent" Margin="4 0">
        <Popup
            x:Name="OptionsPopup"
            Panel.ZIndex="100"
            PlacementTarget="{Binding ElementName=OptionWindowContent}"
            VerticalAlignment="Center"
            Placement="Relative"
            HorizontalAlignment="Center"
            VerticalOffset="0"
            AllowsTransparency="True"
            Opacity="0.8"
            PopupAnimation="Fade"
            ClipToBounds="True"
            StaysOpen="False"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            MouseDown="OptionsPopup_MouseDown">
            <TextBlock
                Name="OptionsPopupText"
                Background="{DynamicResource SuccessBackground}"
                Padding="10" Opacity="0.95">
                Settings Saved.
            </TextBlock>
        </Popup>

        <!-- General -->
        <StackPanel Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <Path Data="{StaticResource IconGeneral}" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="General" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />
            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <ToggleButton
                    x:Name="checkBoxAdvancedMode"
                    Grid.Column="0"
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="Advanced mode"
                    Click="CheckBoxAdvancedMode_Click" />

                <ToggleButton
                    x:Name="checkBoxAutoRefresh"
                    Grid.Column="0"
                    Grid.Row="1"
                    Content="Auto refresh"
                    Style="{StaticResource SettingToggle}"
                    Click="CheckBoxAutoRefresh_Click" />

                <TextBox
                    x:Name="numericUpDownRefreshInterval"
                    Grid.Column="1"
                    Grid.Row="1"
                    Margin="5 0 5 0" />

                <Label
                    x:Name="msText"
                    Grid.Column="2"
                    Grid.Row="1"
                    Content="ms"
                    VerticalAlignment="Center"
                    Padding="5 0" FontWeight="Normal" />

                <ToggleButton
                    x:Name="checkBoxCheckUpdate"
                    Grid.Column="0"
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="Check for updates" />

                <ToggleButton
                    x:Name="checkBoxSingleInstance"
                    Grid.Column="0"
                    Grid.Row="3"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="Single instance" />

                <TextBlock
                    Grid.Column="0"
                    Grid.Row="4"
                    Style="{StaticResource SettingLabel}"
                    Text="Theme" />
                <ComboBox
                    x:Name="comboBoxTheme"
                    Grid.ColumnSpan="2"
                    Grid.Column="1"
                    Grid.Row="4"
                    Style="{StaticResource SettingCombo}"
                    SelectionChanged="ComboBoxTheme_SelectionChanged">
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                    <ComboBoxItem Content="Dark Mint" />
                    <ComboBoxItem Content="Dark Mint Gradient" />
                    <ComboBoxItem Content="Asus ROG" />
                    <ComboBoxItem Content="Dracula" />
                    <ComboBoxItem Content="Retro Wave" />
                    <ComboBoxItem Content="Burnt Orange" />
                    <ComboBoxItem Content="Black" />
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- Appearance -->
        <StackPanel Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <Path Data="{StaticResource IconAppearance}" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />
            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Grid.Row="0"
                    Style="{StaticResource SettingLabel}"
                    Text="Corner radius (Win 11)" />
                <ComboBox
                    x:Name="comboBoxCornerRadius"
                    Grid.ColumnSpan="2"
                    Grid.Column="1"
                    Grid.Row="0"
                    Style="{StaticResource SettingCombo}">
                    <ComboBoxItem Content="Auto" />
                    <ComboBoxItem Content="No Radius" />
                    <ComboBoxItem Content="Default Radius" />
                    <ComboBoxItem Content="Small Radius" />
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- Sensors -->
        <StackPanel Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <Path Data="{StaticResource IconTemperature}" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="Sensors" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />
            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Grid.Row="0"
                    Style="{StaticResource SettingLabel}"
                    Text="Impedance table source" />
                <ComboBox
                    x:Name="comboBoxImpedanceSource"
                    Grid.ColumnSpan="2"
                    Grid.Column="1"
                    Grid.Row="0"
                    Style="{StaticResource SettingCombo}">
                    <ComboBoxItem Content="Legacy" />
                    <ComboBoxItem Content="Extended (experimental)" />
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- Startup & Window -->
        <StackPanel Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <Path Data="{StaticResource IconStartup}" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="Startup &amp; Window" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />
            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <ToggleButton
                    x:Name="checkBoxAutostart"
                    Grid.Column="0"
                    Grid.Row="0"
                    Style="{StaticResource SettingToggle}"
                    Content="Autostart on logon"
                    Click="CheckBoxAutostart_Click" />

                <TextBox
                    x:Name="numericUpDownAutostartDelay"
                    Grid.Column="1"
                    Grid.Row="0"
                    Margin="5 0 5 0" />

                <Label
                    x:Name="secText"
                    Grid.Column="2"
                    Grid.Row="0"
                    Content="sec"
                    VerticalAlignment="Center"
                    Padding="5 0" FontWeight="Normal" />

                <ToggleButton
                    x:Name="checkBoxStartMinimized"
                    Grid.Column="0"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="Start minimized" />

                <ToggleButton
                    x:Name="checkBoxMinimizeToTray"
                    Content="Minimize to tray"
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}" />

                <ToggleButton
                    x:Name="checkBoxSavePosition"
                    Grid.Column="0"
                    Grid.Row="3"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="Save position on app close" />
            </Grid>
        </StackPanel>

        <!-- Screenshot -->
        <StackPanel Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <Path Data="{StaticResource IconScreenshot}" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="Screenshot" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />
            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Grid.Row="0"
                    Style="{StaticResource SettingLabel}"
                    Text="Mode" />
                <ComboBox
                    x:Name="comboBoxScreenshot"
                    Grid.ColumnSpan="2"
                    Grid.Column="1"
                    Grid.Row="0"
                    Style="{StaticResource SettingCombo}">
                    <ComboBoxItem Content="App Window" />
                    <ComboBoxItem Content="Desktop" />
                </ComboBox>

                <TextBlock
                    x:Name="screenshotPath"
                    Grid.Column="0"
                    Grid.Row="1"
                    Style="{StaticResource SettingLabel}"
                    Text="Location" />

                <TextBox
                    x:Name="textBoxScreenshotPath"
                    Grid.Column="1"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="3 0 0 0"
                    Width="151"
                    IsReadOnly="True"
                    VerticalAlignment="Top" />

                <Button
                    x:Name="buttonBrowseScreenshotPath"
                    Grid.Column="3"
                    Grid.Row="1"
                    Content="Browse..."
                    Margin="5 0 0 0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Click="ButtonBrowseScreenshotPath_Click" />
            </Grid>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="buttonSettingsRestart"
                Grid.Column="0"
                Content="Restart"
                Visibility="Hidden"
                Margin="6 6 0 6"
                Width="70"
                Click="ButtonSettingsRestart_Click" />

            <Button
                x:Name="buttonSettingsApply"
                Grid.Column="2"
                Content="Apply"
                Margin="6 6 0 6"
                Style="{DynamicResource {x:Static adonisUi:Styles.AccentButton}}"
                Width="70"
                Click="ButtonSettingsApply_Click" />

            <Button
                x:Name="buttonSettingsCancel"
                Grid.Column="3"
                Content="Close"
                IsCancel="True"
                Width="70"
                Margin="6"
                Click="ButtonSettingsCancel_Click" />
        </Grid>
    </StackPanel>
</local:ThemedAdonisWindow>
