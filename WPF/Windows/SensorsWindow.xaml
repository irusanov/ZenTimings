<local:ThemedAdonisWindow
    xmlns:local="clr-namespace:ZenTimings"
    x:Class="ZenTimings.Windows.SensorsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
    adonisExtensions:CursorSpotlightExtension.RelativeSpotlightSize="0"
    xmlns:windows="clr-namespace:ZenTimings.Windows"
    xmlns:controls="clr-namespace:ZenTimings.Controls"
    mc:Ignorable="d"
    Title="Sensors"
    Height="500"
    Width="392"
    MinWidth="400"
    MinHeight="280"
    WindowStartupLocation="CenterOwner"
    BorderThickness="1"
    UseLayoutRounding="True"
    Style="{DynamicResource WindowStyles}"
    Loaded="Window_Loaded"
    Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <windows:CountToVisibilityConverter x:Key="CountToVis" />
        <windows:WidthOffsetConverter x:Key="WidthOffset" />
        <SolidColorBrush x:Key="ThermalAlarmHighBrush"     Color="{DynamicResource {x:Static adonisUi:Colors.AlertColor}}"/>
        <SolidColorBrush x:Key="ThermalAlarmCriticalBrush" Color="{DynamicResource {x:Static adonisUi:Colors.ErrorColor}}"/>
        <SolidColorBrush x:Key="SubtleSelectionBrush" Color="{DynamicResource {x:Static adonisUi:Colors.AccentColor}}" Opacity="0.15"/>

        <!-- Sensor type icons are defined in Themes/AppIcons.xaml -->

        <Style x:Key="SensorIconStyle" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Data" Value="{StaticResource IconGeneric}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconKind}" Value="{x:Static windows:SensorIconKind.Voltage}">
                    <Setter Property="Data" Value="{StaticResource IconVoltage}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKind}" Value="{x:Static windows:SensorIconKind.Temperature}">
                    <Setter Property="Data" Value="{StaticResource IconTemperature}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKind}" Value="{x:Static windows:SensorIconKind.Power}">
                    <Setter Property="Data" Value="{StaticResource IconPower}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKind}" Value="{x:Static windows:SensorIconKind.Fan}">
                    <Setter Property="Data" Value="{StaticResource IconFan}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuIconStyle" TargetType="{x:Type controls:AppIcon}">
            <Setter Property="IconWidth" Value="12"/>
            <Setter Property="IconHeight" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <DataTemplate x:Key="SensorNameCellTemplate">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource SensorIconStyle}"/>
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextColor}" Padding="3,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="LabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="ValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- CURRENT column -->
        <Style x:Key="TelemetryCurrentValueCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}"/>
            <Setter Property="Padding" Value="3,0"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentAlarmLevel}" Value="{x:Static windows:ThermalAlarmLevel.High}">
                    <Setter Property="Foreground" Value="{StaticResource ThermalAlarmHighBrush}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding CurrentAlarmLevel}" Value="{x:Static windows:ThermalAlarmLevel.CriticalHigh}">
                    <Setter Property="Foreground" Value="{StaticResource ThermalAlarmCriticalBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- MIN column -->
        <Style x:Key="TelemetryMinValueCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}"/>
            <Setter Property="Padding" Value="3,0"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding MinAlarmLevel}" Value="{x:Static windows:ThermalAlarmLevel.High}">
                    <Setter Property="Foreground" Value="{StaticResource ThermalAlarmHighBrush}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding MinAlarmLevel}" Value="{x:Static windows:ThermalAlarmLevel.CriticalHigh}">
                    <Setter Property="Foreground" Value="{StaticResource ThermalAlarmCriticalBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- MAX column -->
        <Style x:Key="TelemetryMaxValueCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}"/>
            <Setter Property="Padding" Value="3,0"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding MaxAlarmLevel}" Value="{x:Static windows:ThermalAlarmLevel.High}">
                    <Setter Property="Foreground" Value="{StaticResource ThermalAlarmHighBrush}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding MaxAlarmLevel}" Value="{x:Static windows:ThermalAlarmLevel.CriticalHigh}">
                    <Setter Property="Foreground" Value="{StaticResource ThermalAlarmCriticalBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- AVERAGE column (temporary: no alarm coloring yet) -->
        <Style x:Key="TelemetryAverageValueCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Module grid — all DIMMs visible simultaneously -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" Margin="0">
            <StackPanel>
            <ItemsControl x:Name="ModulesContainer">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <GroupBox x:Name="ModuleGroupBox" adonisExtensions:LayerExtension.Layer="3"
                                  Background="{DynamicResource PanelBackground}"
                                  Padding="6,3"
                                  Margin="0">
                            <GroupBox.Header>
                                <Grid Width="{Binding ActualWidth, ElementName=ModuleGroupBox, Converter={StaticResource WidthOffset}}" MinHeight="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding HeaderDisplay}" VerticalAlignment="Center" FontSize="11"/>
                                </Grid>
                            </GroupBox.Header>
                            <StackPanel>

                                <!-- Module info -->
                                <Border Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                                        CornerRadius="3" Padding="6,4" Margin="0,2,0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition MinHeight="18"/>
                                            <RowDefinition MinHeight="18"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Manufacturer}" Style="{StaticResource ValueStyle}" Margin="0,2,8,0" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding PartNumber}" Style="{StaticResource ValueStyle}"  Margin="8,0"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Capacity" Style="{StaticResource LabelStyle}" Margin="0,2,8,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Capacity}" Style="{StaticResource ValueStyle}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Rank" Style="{StaticResource LabelStyle}" Margin="8,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Rank}" Style="{StaticResource ValueStyle}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="DRAM" Style="{StaticResource LabelStyle}" Margin="0,2,8,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MemoryChip}"
                                                   Style="{StaticResource ValueStyle}" Margin="0,2,0,0"/>

                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="PMIC" Style="{StaticResource LabelStyle}" Margin="8,2,0,0"
                                                   Visibility="{Binding HasPmic, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource ValueStyle}" Margin="0,2,0,0"
                                                   Visibility="{Binding HasPmic, Converter={StaticResource BoolToVis}}">
                                            <Run Text="{Binding PmicVendor}"/>
                                            <Run Text="rev"/>
                                            <Run Text="{Binding PmicRevision}"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Telemetry DataGrid -->
                                <DataGrid ItemsSource="{Binding TelemetryItems}"
                                      AutoGenerateColumns="False"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeColumns="False"
                                      CanUserSortColumns="False"
                                      Focusable="False"
                                      IsReadOnly="True"
                                      FontSize="11"
                                      RowHeight="18"
                                      ColumnHeaderHeight="20"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                                      adonisExtensions:LayerExtension.Layer="3"
                                      Visibility="{Binding HasTelemetry, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Hide selected" Click="HideSensors_Click">
                                                <MenuItem.Icon>
                                                    <controls:AppIcon Kind="IconHide" Style="{StaticResource MenuIconStyle}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Hide all zero-value sensors" Click="HideZeroValueSensors_Click">
                                                <MenuItem.Icon>
                                                    <controls:AppIcon Kind="IconBlock" Style="{StaticResource MenuIconStyle}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Hide all fans" Click="HideAllFans_Click">
                                                <MenuItem.Icon>
                                                    <controls:AppIcon Kind="IconFan" Style="{StaticResource MenuIconStyle}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Hide all temperatures" Click="HideAllTemperatures_Click">
                                                <MenuItem.Icon>
                                                    <controls:AppIcon Kind="IconTemperature" Style="{StaticResource MenuIconStyle}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Hide all voltages" Click="HideAllVoltages_Click">
                                                <MenuItem.Icon>
                                                    <controls:AppIcon Kind="IconVoltage" Style="{StaticResource MenuIconStyle}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="Margin" Value="0,0,0,2"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="{x:Type DataGridRow}">
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SensorRow_PreviewMouseLeftButtonDown"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SubtleSelectionBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Sensor" CellTemplate="{StaticResource SensorNameCellTemplate}" Width="*" MinWidth="120"/>

                                        <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="*" MinWidth="64">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TelemetryCurrentValueCellStyle}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="*" MinWidth="54">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TelemetryMinValueCellStyle}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="*" MinWidth="54">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TelemetryMaxValueCellStyle}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Average" Binding="{Binding Average}" Width="*" MinWidth="64">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TelemetryAverageValueCellStyle}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- No telemetry message -->
                                <TextBlock Text="No telemetry data available for this module"
                                       Margin="2"
                                       FontStyle="Italic"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextColor}"
                                       Opacity="0.6"
                                       Visibility="{Binding HasNoTelemetry, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Sensor groups — SuperIO sensors grouped per chip -->
                <ItemsControl x:Name="SensorGroupsContainer">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <GroupBox x:Name="SensorGroupBox" adonisExtensions:LayerExtension.Layer="3"
                                  Background="{DynamicResource PanelBackground}"
                                  Padding="6,3"
                                  Margin="0"
                                  Visibility="{Binding TelemetryItems.Count, Converter={StaticResource CountToVis}}">
                            <GroupBox.Header>
                                <Grid Width="{Binding ActualWidth, ElementName=SensorGroupBox, Converter={StaticResource WidthOffset}}" MinHeight="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding HeaderDisplay}" VerticalAlignment="Center" FontSize="11"/>
                                </Grid>
                            </GroupBox.Header>
                            <DataGrid ItemsSource="{Binding TelemetryItems}"
                                      AutoGenerateColumns="False"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeColumns="False"
                                      CanUserSortColumns="False"
                                      Focusable="False"
                                      IsReadOnly="True"
                                      FontSize="11"
                                      RowHeight="18"
                                      ColumnHeaderHeight="20"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                                      adonisExtensions:LayerExtension.Layer="3">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Hide selected" Click="HideSensors_Click">
                                            <MenuItem.Icon>
                                                <controls:AppIcon Kind="IconHide" Style="{StaticResource MenuIconStyle}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Hide all zero-value sensors" Click="HideZeroValueSensors_Click">
                                            <MenuItem.Icon>
                                                <controls:AppIcon Kind="IconBlock" Style="{StaticResource MenuIconStyle}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Hide all fans" Click="HideAllFans_Click">
                                            <MenuItem.Icon>
                                                <controls:AppIcon Kind="IconFan" Style="{StaticResource MenuIconStyle}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Hide all temperatures" Click="HideAllTemperatures_Click">
                                            <MenuItem.Icon>
                                                <controls:AppIcon Kind="IconTemperature" Style="{StaticResource MenuIconStyle}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Hide all voltages" Click="HideAllVoltages_Click">
                                            <MenuItem.Icon>
                                                <controls:AppIcon Kind="IconVoltage" Style="{StaticResource MenuIconStyle}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="{x:Type DataGridRow}">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SensorRow_PreviewMouseLeftButtonDown"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SubtleSelectionBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Sensor" CellTemplate="{StaticResource SensorNameCellTemplate}" Width="*" MinWidth="120"/>

                                    <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="*" MinWidth="64">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TelemetryCurrentValueCellStyle}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="*" MinWidth="54">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TelemetryMinValueCellStyle}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="*" MinWidth="54">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TelemetryMaxValueCellStyle}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Average" Binding="{Binding Average}" Width="*" MinWidth="64">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TelemetryAverageValueCellStyle}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Shown when no supported sensors were found on this system -->
            <TextBlock x:Name="NoSensorsMessage"
                       Text="No sensors available on this system"
                       Margin="4,12"
                       FontStyle="Italic"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextColor}"
                       Opacity="0.6"
                       Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{DynamicResource Separator}"/>

        <Border Grid.Row="2" Style="{DynamicResource BottomPanelStyles}">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" FontSize="11"/>
                <Button x:Name="BtnSensorSettings" DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Width="24" Height="24" Padding="0"
                    Margin="6,0,0,0"
                    ToolTip="Manage Sensors"
                    Click="BtnSensorSettings_Click">
                    <controls:AppIcon Kind="IconSettings" IconWidth="12" IconHeight="12" Fill="{DynamicResource TextColor}"/>
                </Button>
                <Button x:Name="BtnResetStats" DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Content="Reset Stats" Width="80" Height="24"
                    Click="BtnResetStats_Click"/>
                <ToggleButton x:Name="ToggleAutoOpen"
                              DockPanel.Dock="Right"
                              Content="Auto-open"
                              Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}"
                              HorizontalAlignment="Right"
                              Margin="0,0,12,0"
                              FontSize="11"
                              Click="ToggleAutoOpen_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</local:ThemedAdonisWindow>