<local:ThemedAdonisWindow
    xmlns:local="clr-namespace:ZenTimings"
    x:Class="ZenTimings.Windows.ExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    adonisExtensions:CursorSpotlightExtension.RelativeSpotlightSize="0"
    mc:Ignorable="d"
    Title="Export"
    Height="540"
    Width="400"
    MinWidth="340"
    MinHeight="420"
    WindowStartupLocation="CenterOwner"
    BorderThickness="1"
    UseLayoutRounding="True"
    Style="{DynamicResource WindowStyles}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Live snapshot only: the main switch, everything below is disabled while it is off -->
        <StackPanel x:Name="LiveSwitchPanel" Grid.Row="0" Margin="0,0,0,10" Visibility="Collapsed">
            <CheckBox x:Name="CheckLiveEnabled" Content="Enable the live snapshot file" FontWeight="SemiBold" Margin="2,3"
                      Foreground="{DynamicResource TextColor}"
                      Checked="CheckLiveEnabled_Changed" Unchecked="CheckLiveEnabled_Changed"/>
            <TextBlock TextWrapping="Wrap" Margin="2,3" Opacity="0.75" Foreground="{DynamicResource TextColor}"
                       Text="Off by default. While it is on, the file is rewritten together with the main window refresh (auto refresh in advanced mode), no extra hardware reads are made. Turn it off here and press OK to stop writing and remove the file."/>
        </StackPanel>

        <DockPanel x:Name="SectionsHeader" Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Choose what to include" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Default" MinWidth="56" Height="22" Padding="8,0" Margin="4,0,0,0"
                        ToolTip="What the main window shows" Click="BtnSelectDefault_Click"/>
                <Button Content="All" MinWidth="44" Height="22" Padding="8,0" Margin="4,0,0,0" Click="BtnSelectAll_Click"/>
                <Button Content="None" MinWidth="44" Height="22" Padding="8,0" Margin="4,0,0,0" Click="BtnSelectNone_Click"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer x:Name="SectionsViewer" Grid.Row="2" MinHeight="120"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <GroupBox Header="{Binding Header}" adonisExtensions:LayerExtension.Layer="3"
                                  Margin="0,0,0,6" Padding="4">
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsAvailable}" ToolTip="{Binding Hint}"
                                                  ToolTipService.ShowOnDisabled="True"
                                                  Margin="2,3" Foreground="{DynamicResource TextColor}">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="OptionsPanel" Grid.Row="3" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Margin="2,3">
                <TextBlock Text="Format:" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <RadioButton x:Name="RadioJson" Content="JSON" GroupName="Format" Margin="0,0,12,0"
                             Foreground="{DynamicResource TextColor}" Checked="RadioFormat_Checked"/>
                <RadioButton x:Name="RadioText" Content="Text (path = value)" GroupName="Format"
                             Foreground="{DynamicResource TextColor}" Checked="RadioFormat_Checked"/>
            </StackPanel>

            <CheckBox x:Name="CheckLegend" Content="Include a short legend (helps AI assistants read the file)" Margin="2,3"
                      Foreground="{DynamicResource TextColor}"/>

            <CheckBox x:Name="CheckSerials" Content="Include memory module serial numbers" Margin="2,3"
                      Foreground="{DynamicResource TextColor}"/>

            <StackPanel x:Name="LivePanel" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="2,3">
                    <TextBlock Text="Write at most every" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TextInterval" Width="44" Margin="6,0" MaxLength="4"/>
                    <TextBlock Text="seconds" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                </StackPanel>
                <DockPanel Margin="2,3">
                    <TextBlock Text="File name" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TextLiveFileName" MaxLength="100" TextChanged="TextLiveFileName_TextChanged"/>
                </DockPanel>
                <DockPanel Margin="2,3">
                    <Button DockPanel.Dock="Right" Content="Default" MinWidth="56" Height="22" Padding="8,0" Margin="4,0,0,0"
                            ToolTip="Write the file next to ZenTimings" Click="BtnDefaultFolder_Click"/>
                    <Button DockPanel.Dock="Right" Content="Browse..." MinWidth="64" Height="22" Padding="8,0" Margin="4,0,0,0"
                            Click="BtnBrowseFolder_Click"/>
                    <TextBox x:Name="TextLivePath" IsReadOnly="True"/>
                </DockPanel>
                <TextBlock TextWrapping="Wrap" Margin="2,3" Opacity="0.75" Foreground="{DynamicResource TextColor}"
                           Text="Serial numbers are never written to the file. It is removed when the application exits. Anyone who can write to the chosen folder can replace the file, keep it in a folder you trust if other programs rely on it."/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap" Margin="2,6,2,0" Opacity="0.75"
                   Foreground="{DynamicResource TextColor}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="ButtonCopy" Content="Copy" Width="70" Height="24" Click="BtnCopy_Click"/>
            <Button x:Name="ButtonSave" Content="Save..." Width="70" Height="24" Margin="6,0,0,0" IsDefault="True" Click="BtnSave_Click"/>
            <Button x:Name="ButtonOk" Content="OK" Width="70" Height="24" Margin="6,0,0,0" Visibility="Collapsed" Click="BtnOk_Click"/>
            <Button Content="Close" Width="70" Height="24" Margin="6,0,0,0" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</local:ThemedAdonisWindow>
