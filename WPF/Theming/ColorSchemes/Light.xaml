    <Color x:Key="{x:Static theming:ThemeColors.AccentInteractionBorderColor}">#568AE9</Color>
    <Color x:Key="{x:Static theming:ThemeColors.AccentInteractionForegroundColor}">#ffffff</Color>
    <Color x:Key="{x:Static theming:ThemeColors.Layer0BackgroundColor}">#ffffff</Color>
