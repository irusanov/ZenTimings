<!--
    Light color scheme: the base colors every theme builds on (a theme merges one of the schemes and
    overrides the colors it wants to change). Based on the AdonisUI color schemes (MIT license).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:ZenTimings.Theming">

    <!-- colors -->

    <Color x:Key="{x:Static theming:ThemeColors.ForegroundColor}">#000000</Color>
    <Color x:Key="{x:Static theming:ThemeColors.AccentColor}">#5080d8</Color>
    <Color x:Key="{x:Static theming:ThemeColors.AccentHighlightColor}">#6C9CF6</Color>
    <Color x:Key="{x:Static theming:ThemeColors.AccentForegroundColor}">#ffffff</Color>
    <Color x:Key="{x:Static theming:ThemeColors.AccentIntenseHighlightColor}">#85AFFF</Color>
