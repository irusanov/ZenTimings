<!--
    Light color scheme: default palette and the neutral interaction layers of the light
    themes. A theme merges one scheme and redefines the palette colors; all brushes come from Shared.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:ZenTimings.Theming">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ZenTimings;component/Theming/ColorSchemes/Shared.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Default palette -->
    <Color x:Key="{x:Static t:ThemeColors.BackgroundColor}">#F3F3F3</Color>
    <Color x:Key="{x:Static t:ThemeColors.SurfaceColor}">#B3FFFFFF</Color>
    <Color x:Key="{x:Static t:ThemeColors.PopupColor}">#FBFBFB</Color>
    <Color x:Key="{x:Static t:ThemeColors.BorderColor}">#1A000000</Color>
    <Color x:Key="{x:Static t:ThemeColors.ForegroundColor}">#1B1B1B</Color>
    <Color x:Key="{x:Static t:ThemeColors.SecondaryForegroundColor}">#B81B1B1B</Color>
    <Color x:Key="{x:Static t:ThemeColors.DisabledForegroundColor}">#611B1B1B</Color>
    <Color x:Key="{x:Static t:ThemeColors.AccentColor}">#005FB8</Color>
    <Color x:Key="{x:Static t:ThemeColors.AccentForegroundColor}">#FFFFFF</Color>
    <Color x:Key="{x:Static t:ThemeColors.SuccessColor}">#0F7B0F</Color>
    <Color x:Key="{x:Static t:ThemeColors.WarningColor}">#C27C00</Color>
    <Color x:Key="{x:Static t:ThemeColors.ErrorColor}">#C42B1C</Color>

    <!-- Interaction layers: translucent fills that suit any background of a light theme -->
    <SolidColorBrush x:Key="{x:Static t:ThemeBrushes.ControlFillBrush}" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static t:ThemeBrushes.ControlFillHoverBrush}" Color="#80F9F9F9"/>
    <SolidColorBrush x:Key="{x:Static t:ThemeBrushes.ControlFillPressedBrush}" Color="#4DF9F9F9"/>
    <SolidColorBrush x:Key="{x:Static t:ThemeBrushes.SubtleHoverBrush}" Color="#0A000000"/>
    <SolidColorBrush x:Key="{x:Static t:ThemeBrushes.SubtlePressedBrush}" Color="#06000000"/>
</ResourceDictionary>
