    <Color x:Key="{x:Static theming:ThemeColors.Layer1HighlightColor}">#f4f4f4</Color>
    <Color x:Key="{x:Static theming:ThemeColors.Layer1HighlightBorderColor}">#b0b0b0</Color>
    <Color x:Key="{x:Static theming:ThemeColors.Layer1IntenseHighlightColor}">#fcfcfc</Color>
