<!--
    Dark color scheme: default palette and the neutral interaction layers of the dark
    themes. A theme merges one scheme and redefines the palette colors; all brushes come from Shared.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:ZenTimings.Theming">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ZenTimings;component/Theming/ColorSchemes/Shared.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Default palette -->
    <Color x:Key="{x:Static t:ThemeColors.BackgroundColor}">#202020</Color>
    <Color x:Key="{x:Static t:ThemeColors.SurfaceColor}">#0DFFFFFF</Color>
    <Color x:Key="{x:Static t:ThemeColors.PopupColor}">#2C2C2C</Color>
    <Color x:Key="{x:Static t:ThemeColors.BorderColor}">#1AFFFFFF</Color>
    <Color x:Key="{x:Static t:ThemeColors.ForegroundColor}">#F0F0F0</Color>
    <Color x:Key="{x:Static t:ThemeColors.SecondaryForegroundColor}">#B8F0F0F0</Color>
    <Color x:Key="{x:Static t:ThemeColors.DisabledForegroundColor}">#66F0F0F0</Color>
    <Color x:Key="{x:Static t:ThemeColors.AccentColor}">#4F7FE0</Color>
    <Color x:Key="{x:Static t:ThemeColors.AccentForegroundColor}">#FFFFFF</Color>
    <Color x:Key="{x:Static t:ThemeColors.SuccessColor}">#4CC38A</Color>
    <Color x:Key="{x:Static t:ThemeColors.WarningColor}">#FFC107</Color>
    <Color x:Key="{x:Static t:ThemeColors.WarningForegroundColor}">#1A1A1A</Color>
    <Color x:Key="{x:Static t:ThemeColors.ErrorColor}">#FF6B6B</Color>
    <Color x:Key="{x:Static t:ThemeColors.ErrorForegroundColor}">#1A1A1A</Color>

    <!-- Interaction layers: translucent fills that suit any background of a dark theme -->
    <SolidColorBrush x:Key="{x:Static t:ThemeBrushes.ControlFillBrush}" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static t:ThemeBrushes.ControlFillHoverBrush}" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static t:ThemeBrushes.ControlFillPressedBrush}" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static t:ThemeBrushes.SubtleHoverBrush}" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static t:ThemeBrushes.SubtlePressedBrush}" Color="#0AFFFFFF"/>
</ResourceDictionary>
