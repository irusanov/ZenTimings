    <Color x:Key="{x:Static theming:ThemeColors.WindowButtonInteractionColor}">#4C4F62</Color>

    <!-- brushes: each follows the color of the same name, so a theme only overrides colors.
         The interaction brushes follow the accent color, as the interaction colors do by default. -->

    <SolidColorBrush x:Key="{x:Static theming:ThemeBrushes.ForegroundBrush}" Color="{DynamicResource {x:Static theming:ThemeColors.ForegroundColor}}"/>
    <SolidColorBrush x:Key="{x:Static theming:ThemeBrushes.AccentBrush}" Color="{DynamicResource {x:Static theming:ThemeColors.AccentColor}}"/>
